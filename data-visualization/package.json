{
  "type": "module",
  "private": true,
  "scripts": {
    "update": "npm i && uv sync",
    "clean": "rm -rf dist && rm -rf .venv && rm -rf node_modules && rm -rf src/.observablehq/cache",
    "refresh": "rm -rf src/.observablehq/cache/data",
    "build": "rm -rf dist && observable build",
    "build-jsdoc": "jsdoc ./src/components/* -d jsdoc/",
    "dev": "observable preview",
    "deploy": "observable deploy",
    "observable": "observable"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.4-r.3",
    "@observablehq/framework": "latest",
    "@observablehq/plot": "^0.6.17",
    "d3": "latest",
    "d3-cloud": "^1.2.7",
    "d3-sankey": "^0.12.3",
    "exceljs": "^4.4.0",
    "fantasy-name-generator": "^2.0.0",
    "geocoder": "^0.1.0",
    "markdown-it-footnote": "^4.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^13.0.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdoc": "^4.0.4"
  }
}
