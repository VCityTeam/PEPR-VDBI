{
  "type": "module",
  "private": true,
  "scripts": {
    "update": "npm i && uv sync",
    "clean": "npm run clean-cache && npm run clean-dist && npm run clean-dependencies",
    "clean-cache": "rm -rf src/.observablehq/cache/data",
    "clean-dist": "rm -rf dist",
    "clean-dependencies": "rm -rf .venv && rm -rf node_modules",
    "build": "rm -rf dist && BUILD_ENV=production observable build",
    "jsdoc": "jsdoc ./src/components/* -d jsdoc/",
    "dev": "BUILD_ENV=development observable preview",
    "serve": "npx http-server dist",
    "deploy": "observable deploy",
    "observable": "observable"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.4-r.3",
    "@observablehq/framework": "latest",
    "@observablehq/plot": "^0.6.17",
    "d3": "latest",
    "d3-cloud": "^1.2.7",
    "d3-sankey": "^0.12.3",
    "downloadjs": "^1.4.7",
    "exceljs": "^4.4.0",
    "fantasy-name-generator": "^2.0.0",
    "geocoder": "^0.1.0",
    "html-to-image": "1.11.11",
    "markdown-it-footnote": "^4.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^13.0.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdoc": "^4.0.4"
  }
}
